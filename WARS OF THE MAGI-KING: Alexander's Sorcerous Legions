class ConsoleInputAdapter:
    """Normalizes console controller inputs to text interfaces."""
    @staticmethod
    def get_action_map(console_type="UNIVERSAL"):
        mappings = {
            "PLAYSTATION": {"CONFIRM": "❌ (Cross)", "CANCEL": "⭕ (Circle)", "SPECIAL": "🔺 (Triangle)", "STORE": "🔲 (Square)"},
            "XBOX": {"CONFIRM": "🟢 (A)", "CANCEL": "🔴 (B)", "SPECIAL": "🟡 (Y)", "STORE": "🔵 (X)"},
            "SWITCH": {"CONFIRM": "🔴 (A)", "CANCEL": "🔵 (B)", "SPECIAL": "🟢 (X)", "STORE": "🟡 (Y)"},
            "UNIVERSAL": {"CONFIRM": "[1]", "CANCEL": "[2]", "SPECIAL": "[3]", "STORE": "[4]"}
        }
        return mappings.get(console_type, mappings["UNIVERSAL"])

class ItemArtifact:
    def __init__(self, item_id, name, cost, hp, mp, atk, passive, desc):
        self.item_id = item_id
        self.name = name
        self.cost = cost
        self.hp_bonus = hp
        self.mp_bonus = mp
        self.atk_bonus = atk
        self.passive = passive  # "QUANTUM_FLOW", "LIFESTEAL", "TITAN_IMMUNITY"
        self.desc = desc

class HeroMage:
    def __init__(self, name, faction, hp, mana, atk):
        self.name = name
        self.faction = faction
        self.max_hp = hp
        self.hp = hp
        self.max_mana = mana
        self.mana = mana
        self.base_atk = atk
        self.gold = 200
        self.inventory = {}
        self.cooldowns = {"SPECIAL_1": 0, "SPECIAL_2": 0}
        self.status_effects = []

    @property
    def total_attack(self):
        bonus = sum(item.atk_bonus for item in self.inventory.values())
        return self.base_atk + bonus

    def equip_item(self, item):
        self.inventory[item.item_id] = item
        self.max_hp += item.hp_bonus
        self.hp += item.hp_bonus
        self.max_mana += item.mp_bonus
        self.mana += item.mp_bonus

