class StorylineNarrator:
    @staticmethod
    def print_cinematic(text, delay=0.03):
        for char in text:
            sys.stdout.write(char)
            sys.stdout.flush()
            time.sleep(delay)
        print()

    @staticmethod
    def trigger_post_chapter_epilogue(hero, boss_name):
        print("\n" + ConsoleColor.PURPLE + "🎬 === CINEMATIC STORYLINE UNLOCKED ===" + ConsoleColor.RESET)
        print(f"🎬 CHAPTER RESOLUTION NODES: Running tracking matrix for [{hero.name}]")
        print("-" * 80)
        
        if hero.character_id == "ALEXANDER_MAIN":
            StorylineNarrator.print_cinematic(
                f"The smoke clears over the burning plains of Gaugamela. {boss_name}'s elemental matrix shatters into residual embers.\n"
                f"Alexander steps over the fused glass ground, raising his Runic Sarissa high towards the heavens..."
            )
            print(f"\n🗣️  {ConsoleColor.GOLD}{hero.name} steps forward and TAUNTS the fallen Emperor:{ConsoleColor.RESET}")
            StorylineNarrator.print_cinematic(f'   "{hero.taunt_text}"', delay=0.05)
            
        elif hero.character_id == "HEPHAESTION_MAGE":
            StorylineNarrator.print_cinematic(
                f"The chronological barriers close. With the Persian frontline frozen in stasis, the secondary force secures the perimeter.\n"
                f"Hephaestion lowers his gauntlet, adjusting the chronometer configurations."
            )
            print(f"\n🗣️  {ConsoleColor.GOLD}{hero.name} cold-heartedly glances down at {boss_name}:{ConsoleColor.RESET}")
            StorylineNarrator.print_cinematic(f'   "{hero.taunt_text}"', delay=0.05)
            
        print("-" * 80)
        print(ConsoleColor.PURPLE + "=== END OF CHAPTER EXPANSION NARRATIVE ===" + ConsoleColor.RESET + "\n")

