    def run_enemy_ai_matrix(self):
        self.enemy.mana = min(self.enemy.max_mana, self.enemy.mana + 45)
        
        # Simple systemic store routing for AI boss
        if self.enemy.gold >= 150 and "2" not in self.enemy.inventory:
            self.enemy.equip_item(self.vault["2"])
            self.enemy.gold -= 150
            
        # Spawn deployment tracking
        vacant = [s for s in self.grid if self.grid[s]["enemy"] is None]
        if vacant and self.enemy.mana >= 40:
            dest = random.choice(vacant)
            self.enemy.mana -= 40
            self.grid[dest]["enemy"] = {"hp": 140, "atk": 30}

    def compute_combat_resolution(self):
        print("\n⚔️ SYSTEM CALCULATION: SIMULATING MATRIX FRONT CONFLICT...")
        time.sleep(0.8)
        
        for sector, data in self.grid.items():
            p = data["player"]
            e = data["enemy"]
            mod = data["mod"]
            
            if p and e:
                raw_p_dmg = int(p["atk"] * mod)
                raw_e_dmg = int(e["atk"] * mod)
                
                e["hp"] -= raw_p_dmg
                p["hp"] -= raw_e_dmg
                print(f"    💥 Collision at [{sector}]: Units trading {raw_p_dmg} and {raw_e_dmg} raw damage profiles.")
                
                if p["hp"] <= 0: data["player"] = None
                if e["hp"] <= 0: 
                    data["enemy"] = None
                    self.player.gold += 75  # Financial drop reward
            elif p and not e:
                dmg = int(p["atk"] * mod)
                # Scroll of Gilgamesh Passive Check: Lifesteal Implementation
                if "2" in self.player.inventory:
                    steal = int(dmg * 0.30)
                    self.player.hp = min(self.player.max_hp, self.player.hp + steal)
                    print(f"    🩸 Lifesteal Protocol: Converted +{steal} HP back to Alexander's life-pool.")
                self.enemy.hp -= dmg
                print(f"    🏰 [{sector}] Uncontested! Macedonian legionnaires assault Emperor Darius directly for {dmg} damage!")
            elif e and not p:
                dmg = int(e["atk"] * mod)
                self.player.hp -= dmg
                print(f"    💥 Breakthrough at [{sector}]! Persian magic arrays slam into Alexander for {dmg} damage!")

