        while self.player.is_alive() and self.enemy.is_alive():
            self.run_command_loop()
            if self.enemy.hp <= 0: break
            self.trigger_enemy_ai()
            self.resolve_grid_clashes()
            self.turn += 1
            
        if self.player.is_alive() and self.enemy.hp <= 0:
            print("\n" + ConsoleColor.GREEN + "🏆 CHAPTER COMPLETION VERIFIED: BOSS ELIMINATED! 🏆" + ConsoleColor.RESET)
            StorylineNarrator.trigger_post_chapter_epilogue(self.player, self.enemy.name)
        else:
            print("\n💀 GAME OVER: Commander life signal completely dropped out of reality matrix.")

